# Zay Chin Environment Configuration

# Database Configuration
# Default to SQLite for lightweight local development without Docker
DATABASE_URL=sqlite:///./zay_chin.db
# For PostgreSQL (Docker Compose or local PostgreSQL service):
# DATABASE_URL=postgresql+psycopg://zaychin_user:zaychin_password@localhost:5432/zaychin_db

# Security & Authentication
SECRET_KEY=zaychin_super_secret_jwt_key_production_grade_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development
DEBUG=True

# CORS
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001","http://localhost:3000","http://127.0.0.1:3000"]
